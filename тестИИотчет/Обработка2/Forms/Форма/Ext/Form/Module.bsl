
&НаКлиенте
Процедура ОтобразитьОтчет(Команда)
	
	ТабДок = СформироватьОтчетНаСервере();
	
	// Показ макета в отдельном окне
	ТабДок.ОтображатьСетку = Ложь;
	ТабДок.ОтображатьЗаголовки = Ложь;
	ТабДок.ТолькоПросмотр = Истина;
	ТабДок.Показать("Отчет: клиенты и контракты");
	
КонецПроцедуры

&НаСервере
Функция СформироватьОтчетНаСервере()
	
	ОтчетОбъект = РеквизитФормыВЗначение("Объект");
	Макет = ОтчетОбъект.ПолучитьМакет("Макет");
	
	ТабДок = Новый ТабличныйДокумент;
	
	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	ОбластьШапка     = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока    = Макет.ПолучитьОбласть("Строка");
	
	ОбластьЗаголовок.Параметры.ЗаголовокОтчета = "Отчет по клиентам и контрактам";
	ТабДок.Вывести(ОбластьЗаголовок);
	ТабДок.Вывести(ОбластьШапка);
	
	Данные = ПолучитьДанныеОтчета();
	НомерСтроки = 0;
	Для Каждого СтрокаДанных Из Данные Цикл
		НомерСтроки = НомерСтроки + 1;
		ОбластьСтрока.Параметры.НомерСтроки = НомерСтроки;
		ОбластьСтрока.Параметры.Клиент      = СтрокаДанных.Клиент;
		ОбластьСтрока.Параметры.Контракт    = СтрокаДанных.Контракт;
		ТабДок.Вывести(ОбластьСтрока);
	КонецЦикла;
	
	Возврат ТабДок;
	
КонецФункции

&НаСервере
Функция ПолучитьДанныеОтчета()
	
	// Пример данных, чтобы отчет запускался в любой базе.
	// Для реальных данных замените на запрос к конфигурации, например:
	//	Запрос = Новый Запрос;
	//	Запрос.Текст =
	//	"ВЫБРАТЬ
	//	|	ДоговорыКонтрагентов.Владелец КАК Клиент,
	//	|	ДоговорыКонтрагентов.Ссылка КАК Контракт
	//	|ИЗ
	//	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов";
	//	Возврат Запрос.Выполнить().Выгрузить();
	
	Данные = Новый ТаблицаЗначений;
	Данные.Колонки.Добавить("Клиент");
	Данные.Колонки.Добавить("Контракт");
	
	ДобавитьСтроку(Данные, "ООО ""Альфа""", "Договор № 1 от 01.01.2026");
	ДобавитьСтроку(Данные, "ООО ""Бета""",  "Договор № 2 от 15.02.2026");
	ДобавитьСтроку(Данные, "ИП Иванов",    "Договор № 3 от 10.03.2026");
	
	Возврат Данные;
	
КонецФункции

&НаСервере
Процедура ДобавитьСтроку(Данные, Клиент, Контракт)
	НоваяСтрока = Данные.Добавить();
	НоваяСтрока.Клиент   = Клиент;
	НоваяСтрока.Контракт = Контракт;
КонецПроцедуры
